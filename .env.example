# Base URL of the FieldOps API, including the version prefix
VITE_API_URL=http://localhost:5080/api/v1
# Real backend (with VITE_API_MOCK=false):
# VITE_API_URL=https://d2jnspdgnkkq1t.cloudfront.net/api/v1
# true = serve the API from MSW handlers in src/shared/api/mocks
VITE_API_MOCK=false
# SignalR hub, if it is not at the API's origin as /hubs/dispatch
# VITE_HUB_URL=https://example.com/hubs/dispatch
# Google Maps JavaScript API key (maps, geocoding UI)
VITE_GOOGLE_MAPS_KEY=
# Dev only: "false" hides the router and query devtools (Playwright sets it)
# VITE_DEVTOOLS=false
